{:paths ["src/clj" "src/resources"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                   :git/sha "3f33f5d4dcce1f8d97a11b6972e13eb3f0b37654"}
        ;; The two pins move together. Green 3f33f5d is where the SDK reports a
        ;; tofu launch failure — a missing stage directory, a missing binary —
        ;; as exit 127 and so as its `tofu output failed:` step error carrying
        ;; :dir, the way red and blue always did; ONCE's `read-state` trusts
        ;; that step error alone, so below it a fresh clone's create crashes
        ;; instead of reporting its credentials. ONCE b1628b7 carries
        ;; `compute-cluster`, the one implementation of the Compute Cluster
        ;; Standard this package delegates its node set to; below it, 759eb03
        ;; carries the keypair create matrix and the post-destroy cleanup, and
        ;; bc06f2f moved the machine keypair into the operator's ~/.ssh. The
        ;; ONCE pin cannot go below any of them.
        io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                   :git/sha "b1628b7f8546c10fa9b768565bfd839512cb49ca"
                                   :deps/root "green"}}
 :aliases {:dev {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
