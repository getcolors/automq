[Unit]
Description=Install the published AutoMQ certificate and restart if it changed
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/automq/store.env
ExecStart=/usr/local/bin/automq-cert-deploy {{ automq_node_id }} 10.74.1.10:9094,10.74.1.11:9094,10.74.1.12:9094
